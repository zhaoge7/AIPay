{
  "name": "@aipay/merchant-http-adapter",
  "version": "0.2.0",
  "private": true,
  "description": "Private pilot adapter for an externally operated paid JSON GET service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "pnpm run build && node --test --test-concurrency=1 test/**/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aipay/contracts": "workspace:*",
    "@aipay/sdk-ts": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.1",
    "ipaddr.js": "2.2.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
