# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
AIPAY_API_HOST=127.0.0.1
AIPAY_API_PORT=3000
AIPAY_WORKER_CONCURRENCY=1
AIPAY_DATABASE_URL=postgresql://aipay:aipay-local-only@127.0.0.1:54329/aipay_dev
# Generate these local-only values with: pnpm --filter @aipay/api generate:issuer
# AIPAY_MANDATE_SIGNING_KEY_ID=
# AIPAY_MANDATE_SIGNING_PRIVATE_KEY=
# Alipay values are issued by the sandbox console. Never commit real values.
# AIPAY_ALIPAY_MODE=sandbox
# AIPAY_ALIPAY_APP_ID=
# AIPAY_ALIPAY_SELLER_ID=
# AIPAY_ALIPAY_PRIVATE_KEY=
# AIPAY_ALIPAY_PLATFORM_PUBLIC_KEY=
# AIPAY_ALIPAY_NOTIFY_URL=https://api.example.com/provider-webhooks/alipay
