# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
AIPAY_API_HOST=127.0.0.1
AIPAY_API_PORT=3000
AIPAY_WORKER_CONCURRENCY=1
AIPAY_DATABASE_URL=postgresql://aipay:aipay-local-only@127.0.0.1:54329/aipay_dev
# Local deployment defaults to aipay.localhost/internal CA/Fake Provider.
# External pilot deployment requires both values and forces public TLS/Alipay Web Provider.
# AIPAY_DEPLOYMENT_MODE=external
# AIPAY_PUBLIC_ORIGIN=https://pilot.example.com
# Generate these local-only values with: pnpm --filter @aipay/api prepare:env
# AIPAY_MANDATE_SIGNING_KEY_ID=
# AIPAY_MANDATE_SIGNING_PRIVATE_KEY=
# 32-byte base64 AES key for encrypted local backups; prepare:env generates it.
# AIPAY_BACKUP_KEY=
# High-entropy Bearer token for the Prometheus scrape endpoint.
# AIPAY_METRICS_TOKEN=
# Alipay values are issued by the sandbox console. Never commit real values.
# AIPAY_ALIPAY_MODE=sandbox
# AIPAY_ALIPAY_APP_ID=
# AIPAY_ALIPAY_SELLER_ID=
# AIPAY_ALIPAY_PRIVATE_KEY=
# AIPAY_ALIPAY_PLATFORM_PUBLIC_KEY=
# AIPAY_ALIPAY_NOTIFY_URL=https://api.example.com/provider-webhooks/alipay
