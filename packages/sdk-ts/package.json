{
  "name": "@aipay/sdk-ts",
  "version": "0.1.0",
  "private": true,
  "description": "AIPay Agent and merchant TypeScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
