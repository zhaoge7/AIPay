{
  "name": "@aipay/api",
  "version": "0.0.0",
  "private": true,
  "description": "AIPay HTTP API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "pnpm --filter @aipay/worker build && pnpm run build && node --test --test-concurrency=1 test/**/*.test.mjs",
    "prepare:env": "node scripts/prepare-local-env.mjs",
    "sdk:sandbox": "node --env-file-if-exists=../../.env scripts/start-sdk-sandbox.mjs"
  },
  "dependencies": {
    "@aipay/config": "workspace:*",
    "@aipay/contracts": "workspace:*",
    "@aipay/database": "workspace:*",
    "@aipay/policy": "workspace:*",
    "@aipay/payment": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@node-rs/argon2": "2.1.0",
    "@peac/http-signatures": "0.16.4",
    "fastify": "5.12.1",
    "fastify-raw-body": "6.0.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@aipay/sdk-ts": "workspace:*",
    "@aipay/worker": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
