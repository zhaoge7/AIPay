{
  "name": "aipay",
  "version": "0.0.0",
  "private": true,
  "description": "AIPay agent payment orchestration and trust layer",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --build --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "pnpm --recursive --if-present run test",
    "db:up": "node packages/database/scripts/postgres-container.mjs up",
    "db:down": "node packages/database/scripts/postgres-container.mjs down",
    "db:migrate": "node --env-file-if-exists=.env packages/database/scripts/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env packages/database/scripts/reset.mjs"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
